# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# Production database; local tests may fall back to SQLite when unset
DATABASE_URL=postgresql://user:password@db.example.com:5432/stockpilot

# Browser/API security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_RATE_LIMIT=10/minute
SENSITIVE_RATE_LIMIT=60/minute

# Supabase server-only integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-server-only-key
SUPABASE_STORAGE_BUCKET=stockpilot-private

# Groq server-only integration
GROQ_API_KEY=replace-server-only-key
GROQ_MODEL=llama-3.3-70b-versatile

# Upstash/Redis and Celery
REDIS_URL=rediss://default:token@your-upstash-endpoint:6379
CELERY_BROKER_URL=rediss://default:token@your-upstash-endpoint:6379
CELERY_RESULT_BACKEND=rediss://default:token@your-upstash-endpoint:6379

# Frontend browser-safe values only
VITE_API_URL=/api/v1
VITE_APP_NAME=StockPilot AI
